<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E3F2FD">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnVisibilityBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:paddingEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Visibility"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toggle to remove events from attendee dashboard"
            android:textColor="#BBDEFB"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Info banner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Turn on the switch to hide an event from attendees. Turn it off to make it visible again."
        android:textColor="#1565C0"
        android:textSize="12sp"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:layout_marginBottom="4dp"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvVisibilityEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No events found."
        android:textColor="#999999"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone"/>

    <!-- Event list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVisibility"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"/>

</LinearLayout>