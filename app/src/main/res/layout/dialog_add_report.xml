<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Event Report"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvAddReportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="20dp"/>

        <!-- Upload image section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F0F4FF"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸"
                android:textSize="36sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Report Image"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JPEG or PNG image required"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnPickReportImage"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="📷  Select Image"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Image preview (shown after pick) -->
        <ImageView
            android:id="@+id/imgReportPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:background="#F8F8F8"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submitted Notes (optional)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etReportNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Add any additional comments for CCA..."
            android:background="@drawable/bg_input_field"
            android:padding="12dp"
            android:minLines="3"
            android:inputType="textMultiLine"
            android:gravity="top"/>

    </LinearLayout>
</ScrollView>