<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_registration_fee_setup.xml
    Role: Pre-form-builder setup screen.
    Organiser answers:
      1. Do you want a registration fee? (Yes/No)
         If Yes: Registration Fee field + Bank Account Info field
      2. Do you want accommodation?      (Yes/No)
         If Yes: Accommodation Fee field + Bank Account Info field
    Then hits Save to proceed to FormBuilderActivity.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1565C0"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSetupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Form Setup"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configure fees before building the registration form"
                android:textColor="#BBDEFB"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- CARD: Registration Fee -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="16dp"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Do you want a registration fee?"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"/>

            <RadioGroup
                android:id="@+id/rgRegFee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbRegFeeYes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"
                    android:textSize="15sp"
                    android:layout_marginEnd="24dp"/>

                <RadioButton
                    android:id="@+id/rbRegFeeNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"
                    android:textSize="15sp"
                    android:checked="true"/>

            </RadioGroup>

            <!-- Shown only when Yes is selected -->
            <LinearLayout
                android:id="@+id/layoutRegFeeFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registration Fee (e.g. PKR 500)"
                    android:textSize="14sp"
                    android:textColor="#333333"/>

                <EditText
                    android:id="@+id/etRegFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. PKR 500"
                    android:inputType="text"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bank Account Information"
                    android:textSize="14sp"
                    android:textColor="#333333"/>

                <EditText
                    android:id="@+id/etRegBankInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter bank name, account number, IBAN, etc."
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- CARD: Accommodation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Do you want accommodation?"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"/>

            <RadioGroup
                android:id="@+id/rgAccommodation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbAccomYes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"
                    android:textSize="15sp"
                    android:layout_marginEnd="24dp"/>

                <RadioButton
                    android:id="@+id/rbAccomNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"
                    android:textSize="15sp"
                    android:checked="true"/>

            </RadioGroup>

            <!-- Shown only when Yes is selected -->
            <LinearLayout
                android:id="@+id/layoutAccommodationFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accommodation Fee (e.g. PKR 1500)"
                    android:textSize="14sp"
                    android:textColor="#333333"/>

                <EditText
                    android:id="@+id/etAccommodationFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. PKR 1500"
                    android:inputType="text"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bank Account Information"
                    android:textSize="14sp"
                    android:textColor="#333333"/>

                <EditText
                    android:id="@+id/etAccommodationBankInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter bank name, account number, IBAN, etc."
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- SAVE BUTTON -->
        <Button
            android:id="@+id/btnSaveSetup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:text="Save &amp; Build Form"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0"/>

    </LinearLayout>

</ScrollView>