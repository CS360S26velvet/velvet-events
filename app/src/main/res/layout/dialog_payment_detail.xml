<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_payment_detail.xml  (UPDATED)
    Proof shown as inline ImageViews decoded from Base64.
    IDs: imgRegProof, tvNoRegProof, tvAccomProofLabel, imgAccomProof, tvNoAccomProof
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Name + ID -->
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"/>

        <TextView
            android:id="@+id/tvDetailId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AT0000"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"/>

        <!-- REGISTRATION PROOF -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registration Payment Proof"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <ImageView
            android:id="@+id/imgRegProof"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="fitCenter"
            android:background="#F0F4FF"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNoRegProof"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="No proof image uploaded"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#999999"
            android:background="#F8F8F8"
            android:layout_marginBottom="16dp"/>

        <!-- ACCOMMODATION PROOF (hidden if not applicable) -->
        <TextView
            android:id="@+id/tvAccomProofLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accommodation Payment Proof"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#00796B"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/imgAccomProof"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="fitCenter"
            android:background="#E8F5E9"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNoAccomProof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No accommodation proof uploaded"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#999999"
            android:background="#F8F8F8"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Submission details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F8F8"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submission Details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Submitted:"
                    android:textSize="13sp" android:textColor="#666666"/>
                <TextView android:id="@+id/tvDetailSubmitted"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textSize="13sp" android:textColor="#222222"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Amount:"
                    android:textSize="13sp" android:textColor="#666666"/>
                <TextView android:id="@+id/tvDetailAmount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="#222222"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Status:"
                    android:textSize="13sp" android:textColor="#666666"/>
                <TextView android:id="@+id/tvDetailStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pending" android:textSize="13sp"
                    android:textStyle="bold" android:textColor="#FF9800"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Rejection reason -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rejection Reason (if rejecting)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Provide a reason for rejection..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:background="@drawable/bg_input_field"
            android:padding="10dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnConfirmApprove"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Confirm Approve"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnRejectWithReason"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Reject with Reason"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#F44336"/>

    </LinearLayout>

</ScrollView>