<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_vendor_directory.xml
    Blue (#1565C0) header, white cards, filter chips, search bar, grid RecyclerView, FAB.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1565C0"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnVendorBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:textSize="16sp"
                    android:padding="0dp"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vendor Directory"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trusted vendors for your event needs"
                        android:textColor="#BBDEFB"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Search bar -->
            <EditText
                android:id="@+id/etVendorSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Search vendors..."
                android:background="#FFFFFF"
                android:padding="10dp"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- FILTER CHIPS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnFilterAll"
                    android:layout_width="wrap_content" android:layout_height="34dp"
                    android:text="All" android:textSize="12sp"
                    android:backgroundTint="#1565C0" android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"/>

                <Button android:id="@+id/btnFilterCatering"
                    android:layout_width="wrap_content" android:layout_height="34dp"
                    android:text="Catering" android:textSize="12sp"
                    android:backgroundTint="#E8EAF6" android:textColor="#1565C0"
                    android:layout_marginEnd="6dp"/>

                <Button android:id="@+id/btnFilterAV"
                    android:layout_width="wrap_content" android:layout_height="34dp"
                    android:text="AV &amp; Tech" android:textSize="12sp"
                    android:backgroundTint="#E8EAF6" android:textColor="#1565C0"
                    android:layout_marginEnd="6dp"/>

                <Button android:id="@+id/btnFilterPrinting"
                    android:layout_width="wrap_content" android:layout_height="34dp"
                    android:text="Printing" android:textSize="12sp"
                    android:backgroundTint="#E8EAF6" android:textColor="#1565C0"
                    android:layout_marginEnd="6dp"/>

                <Button android:id="@+id/btnFilterDecor"
                    android:layout_width="wrap_content" android:layout_height="34dp"
                    android:text="Decor" android:textSize="12sp"
                    android:backgroundTint="#E8EAF6" android:textColor="#1565C0"
                    android:layout_marginEnd="6dp"/>

                <Button android:id="@+id/btnFilterTransport"
                    android:layout_width="wrap_content" android:layout_height="34dp"
                    android:text="Transport" android:textSize="12sp"
                    android:backgroundTint="#E8EAF6" android:textColor="#1565C0"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Result count -->
        <TextView
            android:id="@+id/tvVendorCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 vendors found"
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"/>

        <!-- Vendor grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVendors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"/>

    </LinearLayout>

    <!-- FAB — Add Vendor -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddVendor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        android:backgroundTint="#1565C0"
        android:tint="#FFFFFF"
        android:contentDescription="Add vendor"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>