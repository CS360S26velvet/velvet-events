<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_admin_event_reports.xml  (REWRITTEN)
    Admin color scheme: #8B1A4A header, white background.
    Societies accordion built programmatically in AdminEventReportsActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5F7">

    <!-- HEADER — admin maroon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#8B1A4A"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnAdminReportsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Event Reports"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Spacer to balance back button -->
        <View
            android:layout_width="64dp"
            android:layout_height="1dp"/>

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap a society to expand. View, approve or reject submitted event reports."
        android:textSize="13sp"
        android:textColor="#666666"
        android:padding="14dp"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvAdminReportsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No submitted reports found."
        android:textSize="15sp"
        android:textColor="#888888"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"/>

    <!-- Societies accordion (built programmatically) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llAdminReportSocieties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>

    </ScrollView>

</LinearLayout>