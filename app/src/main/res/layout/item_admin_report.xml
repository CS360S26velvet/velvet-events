<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="1dp">

    <!-- Left: event info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAdminReportEventName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"/>

        <TextView
            android:id="@+id/tvAdminReportSocietyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Society Name"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:layout_marginTop="2dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvAdminReportEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 —"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tvAdminReportAttendeesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 0"
                android:textSize="11sp"
                android:textColor="#666666"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminReportSubmittedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submitted —"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- View button -->
    <Button
        android:id="@+id/btnAdminViewReport"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="View Report"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0"
        android:layout_marginStart="8dp"/>

</LinearLayout>