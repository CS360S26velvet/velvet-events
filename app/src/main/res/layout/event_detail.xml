<?xml version="1.0" encoding="utf-8"?>
<!--
    event_detail.xml  (UPDATED)
    CHANGES:
      1. Date row now shows Start Date; End Date row added below it (tvEndDate)
      2. Time row REMOVED
      3. Registration Fee row kept (tvFee)
      4. Accommodation Fee row added (tvAccomFee, rowAccomFee) — hidden if no accom fee
      5. Event Schedule section now uses a dynamic container (llScheduleContainer)
         instead of hardcoded items
      6. Register button label changed to "Register for this Event"
    All existing IDs preserved.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:background="#FFFFFF"/>

        <!-- Hero image -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">
            <ImageView
                android:id="@+id/imgHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#88000000"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="bottom"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvHeroCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Society Event"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#7B2FBE"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Event Title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="26sp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- EVENT DETAILS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_margin="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Details"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginBottom="16dp"/>

            <!-- Start Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="📅" android:textSize="16sp"
                    android:textColor="#E53935" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Start Date" android:textColor="#AAAAAA" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvDate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#1A1A2E"
                        android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- End Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="📅" android:textSize="16sp"
                    android:textColor="#E53935" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="End Date" android:textColor="#AAAAAA" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvEndDate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#1A1A2E"
                        android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Venue -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="📍" android:textSize="16sp"
                    android:textColor="#E53935" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Venue" android:textColor="#AAAAAA" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvVenue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#1A1A2E"
                        android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Organizer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="👥" android:textSize="16sp"
                    android:textColor="#E53935" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Organizer" android:textColor="#AAAAAA" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvOrganizer"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#1A1A2E"
                        android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Registration Fee -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="💰" android:textSize="16sp"
                    android:textColor="#E53935" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Registration Fee (if any)"
                        android:textColor="#AAAAAA" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvFee"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Free" android:textColor="#1A1A2E"
                        android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Accommodation Fee (hidden if none) -->
            <LinearLayout
                android:id="@+id/rowAccomFee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="🏨" android:textSize="16sp"
                    android:textColor="#E53935" android:layout_marginEnd="12dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Accommodation Fee (if any)"
                        android:textColor="#AAAAAA" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvAccomFee"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="#1A1A2E"
                        android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#EEEEEE" android:layout_marginBottom="14dp"/>

            <!-- Capacity -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Capacity" android:textColor="#AAAAAA"
                android:textSize="11sp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:id="@+id/tvSeats"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 / 0 registered"
                    android:textColor="#1A1A2E" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/tvSeatsPercent"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0% full"
                    android:textColor="#4CAF50" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/progressSeats"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="10dp"
                android:max="100" android:progress="0"
                android:progressTint="#F5A623" android:progressBackgroundTint="#EEEEEE"/>

        </LinearLayout>

        <!-- ABOUT THIS EVENT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About this Event"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#444444"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- EVENT SCHEDULE CARD (dynamic) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Schedule"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginBottom="16dp"/>

            <!-- Dynamic session rows added programmatically -->
            <LinearLayout
                android:id="@+id/llScheduleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- ACTION BUTTONS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:elevation="2dp">

            <Button android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Register for this Event"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#E53935"
                android:layout_marginBottom="10dp"/>

            <Button android:id="@+id/btnAddToCalendar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="↓  Add to Calendar"
                android:textColor="#1A1A2E"
                android:textSize="14sp"
                android:backgroundTint="#FFFFFF"
                android:layout_marginBottom="10dp"/>

            <Button android:id="@+id/btnBackBottom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="← Back"
                android:textColor="#1A1A2E"
                android:textSize="14sp"
                android:backgroundTint="#F5F5F5"/>
        </LinearLayout>

        <TextView android:id="@+id/tvRegCloses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>

    </LinearLayout>
</ScrollView>