<?xml version="1.0" encoding="utf-8"?>
<!--
    item_form_info_card.xml
    Role: Fee/Accommodation info block shown inside the registration form dialog.
    IDs: tvCardTitle, tvCardFee, tvCardBank, btnCardFileUpload
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFF8E1"
    android:padding="14dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registration Payment"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#E65100"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCardFee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fee: PKR 500"
        android:textSize="13sp"
        android:textColor="#333333"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvCardBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bank Info: —"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnCardFileUpload"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Attach Proof"
        android:textSize="13sp"
        android:textColor="#1565C0"
        android:backgroundTint="#E3F2FD"/>

</LinearLayout>