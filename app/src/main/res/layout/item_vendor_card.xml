<?xml version="1.0" encoding="utf-8"?>
<!--
    item_vendor_card.xml
    White card, 2-column grid. Shows logo (optional), name, category badge,
    star rating, used-by count, Contact button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:layout_margin="6dp"
    android:elevation="2dp">

    <!-- Logo (shown when available) -->
    <ImageView
        android:id="@+id/imgVendorLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Vendor name -->
    <TextView
        android:id="@+id/tvVendorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vendor Name"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="6dp"/>

    <!-- Category badge -->
    <TextView
        android:id="@+id/tvVendorCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textSize="11sp"
        android:textColor="#1565C0"
        android:background="#E8EAF6"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginBottom="8dp"/>

    <!-- Star rating -->
    <TextView
        android:id="@+id/tvVendorRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="★★★★☆  4.3"
        android:textSize="13sp"
        android:textColor="#F5A623"
        android:layout_marginBottom="4dp"/>

    <!-- Used by count -->
    <TextView
        android:id="@+id/tvVendorUsedBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Used by 0 societies"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="10dp"/>

    <!-- Contact button -->
    <Button
        android:id="@+id/btnVendorContact"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="Contact"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:backgroundTint="#1565C0"/>

</LinearLayout>