<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="1dp">

    <!-- Event name + date + attendees -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvReportEventName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"/>

        <TextView
            android:id="@+id/tvReportEventDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 —"
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvReportAttendees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 0"
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- Submitted date -->
    <TextView
        android:id="@+id/tvReportSubmittedDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="—"
        android:textSize="11sp"
        android:textColor="#555555"/>

    <!-- Status badge -->
    <TextView
        android:id="@+id/tvReportStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Pending"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#E65100"
        android:backgroundTint="#FFF3E0"/>

    <!-- Action button -->
    <Button
        android:id="@+id/btnReportAction"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1.5"
        android:text="Add Report"
        android:textSize="10sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0"
        android:layout_marginStart="4dp"/>

</LinearLayout>