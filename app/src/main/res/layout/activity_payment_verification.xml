<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_payment_verification.xml
    Role: Main payment verification screen.
    Shows stat cards (Pending / Approved / Rejected),
    search + filter tabs, and a table/list of registrants.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F0">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVerificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment Verification"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Stat cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Pending -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="6dp"
            android:elevation="2dp">

            <View
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="#FFC107"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvStatPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Verification"
                android:textSize="11sp"
                android:textColor="#666666"/>

        </LinearLayout>

        <!-- Approved -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="6dp"
            android:elevation="2dp">

            <View
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="#4CAF50"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvStatApproved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textSize="11sp"
                android:textColor="#666666"/>

        </LinearLayout>

        <!-- Rejected -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:elevation="2dp">

            <View
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="#F44336"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvStatRejected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rejected"
                android:textSize="11sp"
                android:textColor="#666666"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Search + Filter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Search bar -->
        <EditText
            android:id="@+id/etSearchRegistrant"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Search by name or student ID..."
            android:background="@drawable/bg_input_field"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- Filter tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="All"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnFilterPending"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Pending"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#EEEEEE"
                android:textColor="#333333"/>

            <Button
                android:id="@+id/btnFilterApproved"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Approved"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#EEEEEE"
                android:textColor="#333333"/>

            <Button
                android:id="@+id/btnFilterRejected"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Rejected"
                android:textSize="12sp"
                android:backgroundTint="#EEEEEE"
                android:textColor="#333333"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Column headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="STUDENT NAME"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#555555"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="STUDENT ID"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#555555"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="SUBMITTED"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#555555"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AMOUNT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#555555"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STATUS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#555555"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="ACTIONS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#555555"/>

    </LinearLayout>

    <!-- Registrant list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRegistrants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>