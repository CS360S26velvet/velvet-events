<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="1dp"
    android:gravity="center_vertical">

    <!-- Left: name + student ID + check-in status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attendee Name"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"/>

        <TextView
            android:id="@+id/tvStudentId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AT0000"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvCheckInStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not yet"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="3dp"/>

    </LinearLayout>

    <!-- Oval / pill Check In button -->
    <Button
        android:id="@+id/btnCheckIn"
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:text="Check In"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_oval_blue"/>

</LinearLayout>